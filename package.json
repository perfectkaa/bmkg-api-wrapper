{
  "name": "bmkg-ts",
  "version": "1.0.0",
  "description": "TypeScript wrapper for BMKG Open Data API (Badan Meteorologi, Klimatologi, dan Geofisika)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "bmkg",
    "indonesia",
    "weather",
    "earthquake",
    "api-wrapper",
    "typescript"
  ],
  "author": "bmkg-ts contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/example/bmkg-ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.3"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "vitest": "^3.2.0",
    "typescript": "^5.9.2"
  }
}