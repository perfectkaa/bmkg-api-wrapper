# Ignore all dotfiles (files starting with .) except .gitignore
.*
!.gitignore

# Dependencies
node_modules/

# Build output
dist/

# Environment variables
.env
.env.local
.env.development
.env.production

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Test coverage
coverage/
.nyc_output

# TypeScript
*.tsbuildinfo

# Optional: ignore agent session and progress files
.agent/
agent_session*
PROGRESS.md